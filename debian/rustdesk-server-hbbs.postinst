#!/bin/sh
set -e

SERVICE=rustdesk-hbbs.service
ENV_FILE=/etc/rustdesk-server/hbbs.env

if [ "$1" = "configure" ]; then
    mkdir -p /var/log/rustdesk-server
fi

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
      mkdir -p /var/lib/rustdesk-server/
	  # hbbs needs a PostgreSQL database shared with sctgdesk-api-server.
	  mkdir -p /etc/rustdesk-server
	  if [ ! -f "${ENV_FILE}" ]; then
		(umask 077; cat > "${ENV_FILE}") <<EOF
# Environment for hbbs (rustdesk-hbbs.service).
#
# Required: the PostgreSQL database shared with sctgdesk-api-server. The
# api-server creates the schema; hbbs waits until it exists.
DB_URL=
#
# URL of sctgdesk-api-server, used to validate tokens when LOGGED_IN_ONLY=Y.
#API_SERVER=http://127.0.0.1:21114
#LOGGED_IN_ONLY=Y
EOF
	  fi
	  deb-systemd-helper unmask "${SERVICE}" >/dev/null || true
	  if deb-systemd-helper --quiet was-enabled "${SERVICE}"; then
	  	deb-systemd-invoke enable "${SERVICE}" >/dev/null || true
	  else
	  	deb-systemd-invoke update-state "${SERVICE}" >/dev/null || true
	  fi
	  systemctl --system daemon-reload >/dev/null || true
	  if ! grep -q '^DB_URL=..*' "${ENV_FILE}"; then
		echo "rustdesk-hbbs: set DB_URL in ${ENV_FILE}, then run: systemctl restart ${SERVICE}"
	  elif [ -n "$2" ]; then
		deb-systemd-invoke restart "${SERVICE}" >/dev/null || true
	  else
		deb-systemd-invoke start "${SERVICE}" >/dev/null || true
	  fi
    ;;
esac

exit 0
